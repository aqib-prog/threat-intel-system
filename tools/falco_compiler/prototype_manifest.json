    {
      "source_file": "plugins/k8saudit/rules/k8s_audit_rules.yaml",
      "rule": "Anonymous Request Allowed",
      "platform": "kubernetes",
      "positive_samples": [
        {
          "stage": "ResponseComplete",
          "verb": "get",
          "user": {"username": "system:anonymous"},
          "requestURI": "/api/v1/namespaces/default/secrets",
          "annotations": {"authorization.k8s.io/decision": "allow"}
        }
      ],
      "negative_samples": [
        {
          "stage": "ResponseComplete",
          "verb": "get",
          "user": {"username": "system:anonymous"},
          "requestURI": "/healthz?verbose=1",
          "annotations": {"authorization.k8s.io/decision": "allow"}
        },
        {
          "stage": "ResponseComplete",
          "verb": "get",
          "user": {"username": "system:anonymous"},
          "requestURI": "/api/v1/secrets",
          "annotations": {"authorization.k8s.io/decision": "forbid"}
        }
      ]
    },
    {
