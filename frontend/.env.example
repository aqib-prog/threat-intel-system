# Backend API origin. Defaults to http://localhost:8000 for local dev if
# unset. Must be an https:// origin in production - see index.html's CSP
# connect-src, which needs updating to match this value.
VITE_API_BASE=http://localhost:8000

# Must match the backend's API_KEYS (backend/.env). Leave blank for local
# dev if the backend also has no API_KEYS set (auth disabled on both sides).
# NOTE: this value is bundled into the public JS build - it deters casual
# abuse of a discovered API URL, it is not a secret from this app's own
# users. See backend/api/README.md's auth section for the full caveat.
VITE_API_KEY=
