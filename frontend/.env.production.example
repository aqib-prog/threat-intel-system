# Vite auto-loads this for `vite build --mode production` (also the default
# for a plain `vite build`). Copy to .env.production (gitignored) and fill in
# the real production API origin.
VITE_API_BASE=https://api.your-domain.example
# Must match the backend's API_KEYS for production.
VITE_API_KEY=<from secret manager>
