# Application environment
APP_ENV=local
API_TITLE=Threat Intel GraphRAG API
API_VERSION=1.0.0

# API server
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_QUERY_CHARS=100000

# Pipeline defaults
PIPELINE_TOP_K=8
PIPELINE_CANDIDATE_K=30
API_MAX_TOP_K=25
API_MAX_CANDIDATE_K=100
MIN_RERANK_RELEVANCE_SCORE=0.5
NEO4J_QUERY_TIMEOUT_SECONDS=30

# Neo4j
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# Local LLM / Ollama
OLLAMA_HOST=http://127.0.0.1:11434

# Rate limiting (per client IP). In-memory by default - only correct with a
# single worker process. Set RATE_LIMIT_STORAGE_URI (e.g. redis://host:6379)
# before running multiple workers/instances.
RATE_LIMIT_QUERY=20/minute
RATE_LIMIT_FILTERS=30/minute
RATE_LIMIT_STATS=60/minute
RATE_LIMIT_STORAGE_URI=

# Landing-page stats endpoint cache (seconds)
STATS_CACHE_SECONDS=60

# API key auth on /query and /filters (security/auth.py). Unset = auth
# disabled (fine for local dev only). Comma-separate for multiple keys.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Must match VITE_API_KEY in frontend/.env.
API_KEYS=
