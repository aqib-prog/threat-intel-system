# Production. Values are placeholders - inject real ones via your host's
# secret manager (e.g. AWS Secrets Manager, Doppler, Vault), never a file on
# disk or a CI variable printed to logs.

APP_ENV=production
API_TITLE=Threat Intel GraphRAG API
API_VERSION=1.0.0

API_HOST=0.0.0.0
API_PORT=8000
# Your real production frontend origin(s) only.
CORS_ORIGINS=https://your-domain.example
MAX_QUERY_CHARS=8000

PIPELINE_TOP_K=8
PIPELINE_CANDIDATE_K=30
API_MAX_TOP_K=25
API_MAX_CANDIDATE_K=100
MIN_RERANK_RELEVANCE_SCORE=0.5
NEO4J_QUERY_TIMEOUT_SECONDS=30

# Managed/private Neo4j instance, private network only (VPC/private subnet) -
# never publicly routable, never on a shared/default password.
NEO4J_URI=neo4j+s://<prod-host>:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<from secret manager>

OLLAMA_HOST=<production LLM endpoint>

# Tightest limits - tune from real observed traffic.
RATE_LIMIT_QUERY=20/minute
RATE_LIMIT_FILTERS=30/minute
RATE_LIMIT_STATS=60/minute
# Required for production: this API should run multiple workers/instances
# behind a load balancer, and in-memory rate limiting does not share state
# across them.
RATE_LIMIT_STORAGE_URI=redis://<prod-redis-host>:6379

STATS_CACHE_SECONDS=60

# REQUIRED here - unset means /query and /filters run unauthenticated.
# /health reports "auth": "MISCONFIGURED" if this is missing in staging/prod.
# Rotate by adding the new key alongside the old (comma-separated), updating
# the frontend, then removing the old one - zero-downtime rotation.
API_KEYS=<from secret manager>

