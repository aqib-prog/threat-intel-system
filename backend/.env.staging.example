# Staging. Values are placeholders - inject real ones via your host's secret
# manager / CI environment, never a committed file.

APP_ENV=staging
API_TITLE=Threat Intel GraphRAG API
API_VERSION=1.0.0

API_HOST=0.0.0.0
API_PORT=8000
# Your staging frontend origin(s) only - no wildcards.
CORS_ORIGINS=https://staging.your-domain.example
MAX_QUERY_CHARS=8000

PIPELINE_TOP_K=8
PIPELINE_CANDIDATE_K=30
API_MAX_TOP_K=25
API_MAX_CANDIDATE_K=100
MIN_RERANK_RELEVANCE_SCORE=0.5
NEO4J_QUERY_TIMEOUT_SECONDS=30

# Managed/private Neo4j instance - never publicly routable.
NEO4J_URI=neo4j+s://<staging-host>:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<from secret manager>

OLLAMA_HOST=<staging LLM endpoint>

# Tighter than dev, looser than prod - staging still sees real traffic from QA/demo users.
RATE_LIMIT_QUERY=20/minute
RATE_LIMIT_FILTERS=30/minute
RATE_LIMIT_STATS=60/minute
# Required once you run >1 worker/instance - in-memory limits don't share state.
RATE_LIMIT_STORAGE_URI=redis://<staging-redis-host>:6379

STATS_CACHE_SECONDS=60

# REQUIRED here - unset means /query and /filters run unauthenticated.
# /health reports "auth": "MISCONFIGURED" if this is missing in staging/prod.
API_KEYS=<from secret manager>

