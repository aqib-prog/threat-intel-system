# Local development. Copy to `.env` and fill in real values - never commit `.env`.

APP_ENV=development
API_TITLE=Threat Intel GraphRAG API
API_VERSION=1.0.0

API_HOST=127.0.0.1
API_PORT=8000
# Vite dev server origins only.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_QUERY_CHARS=100000

PIPELINE_TOP_K=8
PIPELINE_CANDIDATE_K=30
API_MAX_TOP_K=25
API_MAX_CANDIDATE_K=100
MIN_RERANK_RELEVANCE_SCORE=0.5
NEO4J_QUERY_TIMEOUT_SECONDS=30

NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

OLLAMA_HOST=http://127.0.0.1:11434

# Generous local limits - you're the only client hitting this.
RATE_LIMIT_QUERY=60/minute
RATE_LIMIT_FILTERS=60/minute
RATE_LIMIT_STATS=120/minute
RATE_LIMIT_STORAGE_URI=

STATS_CACHE_SECONDS=30

# Optional in dev - leave unset to skip auth entirely while developing.
API_KEYS=
